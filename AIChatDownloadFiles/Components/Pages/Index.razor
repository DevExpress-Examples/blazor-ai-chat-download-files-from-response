@page "/"
@rendermode InteractiveServer
@using DevExpress.AIIntegration.Blazor.Chat
@using Microsoft.Extensions.AI
@using OpenAI.Responses
@using Markdig
@using Ganss.Xss

<DxAIChat>
    <PromptSuggestions>
        <DxAIChatPromptSuggestion Title="Generate Excel file" Text="Generate an Excel file with a multiplication table" PromptMessage="Generate an Excel file that shows the multiplication table." />
    </PromptSuggestions>
    <MessageContentTemplate>
        @if (context.Role == ChatMessageRole.Assistant)
        {
            @ToHtmlWithFileLinks(context.Text, context.Contents)
        }
        else
        {
            @context.Text
        }
    </MessageContentTemplate>
</DxAIChat>

@code {
    private readonly HtmlSanitizer sanitizer = new HtmlSanitizer();

#pragma warning disable OPENAI001
    MarkupString ToHtmlWithFileLinks(string text, IReadOnlyList<AIContent> contents)
    {
        var fileCitations = new List<ContainerFileCitationMessageAnnotation>();
        foreach (var content in contents) {
            if (content.Annotations is null) {
                continue;
            }
            foreach (AIAnnotation annotation in content.Annotations) {
                if (annotation is CitationAnnotation citation
                    && citation.RawRepresentation is ContainerFileCitationMessageAnnotation containerCitation
                    && containerCitation.FileId != null) {
                    fileCitations.Add(containerCitation);
                }
            }
        }
        foreach (var containerCitation in fileCitations.OrderByDescending(c => c.StartIndex)) {
            var newUrl = $"downloads/{containerCitation.ContainerId}/{containerCitation.FileId}?filename={containerCitation.Filename}";
            text = text.Remove(containerCitation.StartIndex, containerCitation.EndIndex - containerCitation.StartIndex);
            text = text.Insert(containerCitation.StartIndex, newUrl);
        }
        string html = Markdown.ToHtml(text);
        html = sanitizer.Sanitize(html);
        return new MarkupString(html);
    }
#pragma warning restore OPENAI001
}
